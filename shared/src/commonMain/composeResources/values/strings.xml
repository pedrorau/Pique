    <!-- Read the water: rip current ("pozo") -->
    <string name="read_water_title">Leer el agua</string>
    <string name="pozo_title">El pozo</string>
    <string name="pozo_intro">Lo que muchos pescadores llaman pozo es una corriente de resaca vista desde arriba: un corte hondo en la barra de arena por donde el agua sale mar adentro.</string>
    <string name="pozo_animation_description">Animación de una playa vista desde arriba: las olas rompen sobre dos barras de arena, el pozo queda oscuro al centro, la corriente sale mar adentro y un pescador lanza al borde.</string>
    <string name="pozo_play">Reproducir animación</string>
    <string name="pozo_pause">Pausar animación</string>
    <string name="pozo_tide">Marea</string>
    <string name="pozo_tide_low">Bajamar</string>
    <string name="pozo_tide_mid">Media</string>
    <string name="pozo_tide_high">Pleamar</string>
